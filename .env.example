# LibreCrawl Docker Environment Configuration

# Host binding for the application
# - 127.0.0.1 = localhost only (local development)
# - 0.0.0.0 = all interfaces (production, accessible from network)
HOST_BINDING=127.0.0.1

# Host port (container always listens on 5000 internally). Default is 5000 —
# only override this in your own local .env if another project on your
# machine already binds 5000.
HOST_PORT=5000

# Local mode - enables auto-login with admin access, no rate limits
# Set to "true" for local development, "false" for production
LOCAL_MODE=false

# Disable user registrations
# Set to "true" to prevent new users from registering
# Useful for production environments where you only want existing users
REGISTRATION_DISABLED=true

# DANGEROUSLY SKIP AUTH
# Set to "true" to let anyone log in as any username with no password.
# The username is only used to keep per-user sessions separate.
# DO NOT enable on a public network or in production.
DANGEROUSLY_SKIP_AUTH=false

# Allowed email domain for login— only addresses ending in this domain can log in
ALLOWED_EMAIL_DOMAIN=yourcompany.com

# Email Configuration for verification emails
# SMTP server settings
SMTP_HOST=smtp.emailservice.com
SMTP_PORT=587
SMTP_USER=your-sending-account@yourcompany.com
SMTP_PASSWORD=your-app-password 
SMTP_FROM=noreply@yourcompany.com
SMTP_FROM_NAME=LibreCrawl

# Base URLs for email links (used to generate verification links)
MAIN_APP_URL=https://crawl.librecrawl.com
WORKSHOP_APP_URL=https://workshop.librecrawl.com

# Optional: enables AI-powered per-issue explanations in the Page Diagnostics plugin
# Supports OpenAI (OPENAI_API_KEY) or Anthropic (ANTHROPIC_API_KEY)
# Not required to ship — the plugin works with built-in knowledge base
OPENAI_API_KEY=sk-xxxxx
# ANTHROPIC_API_KEY=

# AI model names — change here to swap models without touching code
# Agentic loop (orchestration): needs reasoning quality for multi-step tool calls
ANTHROPIC_MODEL=xxxxx
OPENAI_MODEL=xxxxx
# Explain/chat (fast tasks): per-issue explanations and HITL chat filtering
ANTHROPIC_EXPLAIN_MODEL=xxxxx
OPENAI_EXPLAIN_MODEL=xxxxx

# Max entries kept in the in-memory per-call token usage log (GUI token count panel).
USAGE_LOG_MAX=500

# MCP server base URL — Flask app that MCP tools call back into
MCP_BASE_URL=http://localhost:5000

# Azure DevOps integration — enables ticket creation from Page Diagnostics
# Tickets are created as Product Backlog Items (Scrum) assigned to the Scrum Master
# Generate a PAT at: dev.azure.com → avatar → Personal Access Tokens
# Required PAT scope: Work Items (Read & Write)
AZURE_DEVOPS_ORG=YourCompany
AZURE_DEVOPS_PAT=xxxxx
AZURE_AREA_SUFFIX =YourArea
AZURE_DEVOPS_SM_EMAIL=name@yourcompany.com
AZURE_DEVOPS_PROCESS=Scrum

# State name to set on a ticket after Agent 3 successfully applies a fix.
# Must match an existing state name in your Azure process for the work item type
# (varies by project — check Project Settings -> Process -> Product Backlog Item -> States)
AZURE_QA_STATE=QA

# State name Agent 4 sets on a ticket once a QA recheck confirms the issue is gone.
# Must match an existing state name in your Azure process, same as AZURE_QA_STATE above.
AZURE_QA_DONE_STATE=Done

# Tag used by the QA Bulk Run panel (Agent 4 — batch) to find tickets ready for automated recheck.
# Must already exist as a tag in Azure DevOps (tag creation requires 'Manage tags' permission).
# The QA Bulk Run checklist loads all tickets carrying this tag regardless of state.
AZURE_QA_TAG=xxxx

# Tag Agent 3 adds to any ticket it successfully applies a fix to, so a human scanning
# Azure DevOps can filter/see what the agent touched at a glance (separate from the
# free-text comments it also leaves). Read-modify-write against System.Tags — never
# overwrites tags already on the ticket.
AZURE_FIX_TAG=xxxx

# Agent enable/disable flags — set to 'false' to disable an agent without removing its code.
# Agent 2: agentic triage (Run Agent button → filtered checklist)
# Agent 3: auto-fix via WordPress REST API (runs after ticket creation, requires WP credentials)
# Agent 4: QA recheck (single ticket check + bulk run panel)
AGENT2_ENABLED=true
AGENT3_ENABLED=true
AGENT4_ENABLED=true

# Application Password auth — the only mechanism Agent 3 uses to write to WordPress.
# Generate at: WP Admin → Users → Profile → Application Passwords.
WP_USERNAME=agent_user
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
